  "catmeta.medicine_name": "Anthroposophic Medicine",
  "catmeta.medicine_desc": "Anthroposophic physicians, clinics, hospitals, therapeutic eurythmy, art therapy, Weleda and WALA remedies, and nurse training programs.",
  "catmeta.the_christian_community_name": "The Christian Community",
  "catmeta.the_christian_community_desc": "Congregations and centers of The Christian Community (Die Christengemeinschaft), the Movement for Religious Renewal founded in 1922 with the help of Rudolf Steiner: Sunday services, sacraments, festivals and study.",
  "catmeta.camphill_name": "Community & Camphill",
  "catmeta.camphill_desc": "Camphill communities, intentional living, co-worker positions, volunteer programs, and inclusive communities for people with disabilities.",
  "catmeta.free_name": "Free & Sharing",
  "catmeta.free_desc": "Free items, giveaways, seed exchanges, skill shares, tool lending, and community barter within the anthroposophical world.",
  "catmeta.marketplace_name": "Marketplace",
  "catmeta.marketplace_desc": "Buy, sell, and trade anthroposophical books, biodynamic products, handcrafts, musical instruments, art, and educational materials.",
  "catmeta.housing_name": "Housing & Room Rent",
  "catmeta.housing_desc": "Rooms, apartments, and community housing near Waldorf schools, Camphill communities, and biodynamic farms. Land for intentional communities.",
  "catmeta.jobs_name": "Jobs & Volunteering",
  "catmeta.jobs_desc": "Waldorf teaching positions, biodynamic farm apprenticeships, Camphill co-worker roles, administrative jobs, and volunteer opportunities across the movement.",
  "catmeta.groups_name": "Groups & Circles",
  "catmeta.groups_desc": "Study circles, meditation groups, reading groups, local branch meetings, youth groups, and working groups in the anthroposophical tradition.",
  "catmeta.online_name": "Online Resources",
  "catmeta.online_desc": "Websites, archives, podcasts, video channels, online courses, and digital tools for the anthroposophical community.",
  "catmeta.societies_name": "Societies & Organizations",
  "catmeta.societies_desc": "National and international anthroposophical societies, branches, federations, and membership organizations.",
